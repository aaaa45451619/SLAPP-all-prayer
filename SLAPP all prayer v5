-- Loop Fling Button
local isLoopFlinging = false
local loopFlingThread = nil

local loopFlingBtn = Instance.new("TextButton")
loopFlingBtn.Position = UDim2.new(0, 0, 11, 0)
loopFlingBtn.Size = UDim2.new(1, 0, 2, 0)
loopFlingBtn.Text = "Loop Fling: Off"
loopFlingBtn.TextScaled = true
loopFlingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
loopFlingBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
loopFlingBtn.BorderColor3 = Color3.fromRGB(255, 255, 255)
loopFlingBtn.Parent = mainframe2

function findTargetPlayer(name)
    local lowerName = name:lower()
    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr ~= localplr and plr.Character then
            if string.find(plr.Name:lower(), lowerName) or (plr.DisplayName and string.find(plr.DisplayName:lower(), lowerName)) then
                return plr
            end
        end
    end
    return nil
end

loopFlingBtn.MouseButton1Click:Connect(function()
    isLoopFlinging = not isLoopFlinging
    if isLoopFlinging then
        loopFlingBtn.Text = "Loop Fling: ON"
        local glove, event = getglove()
        local targetName = textbox.Text
        
        if event and targetName ~= "" then
            loopFlingThread = coroutine.wrap(function()
                while isLoopFlinging do
                    local targetPlayer = findTargetPlayer(targetName)
                    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        event:FireServer("slash", targetPlayer.Character, Vector3.new(0, tonumber("inf"), 0))
                        local hRootPart = targetPlayer.Character.HumanoidRootPart
                        hRootPart.Position = hRootPart.Position + Vector3.new(0, 50, 0)
                    end
                    task.wait(0.1)
                end
            end)()
        else
            isLoopFlinging = false
            loopFlingBtn.Text = "Loop Fling: Off"
        end
    else
        loopFlingBtn.Text = "Loop Fling: Off"
        if loopFlingThread then
            loopFlingThread = nil
        end
    end
end)

