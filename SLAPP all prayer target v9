	Tab:CreateToggle({
		Name = "TPFling",
		CurrentValue = false,
		Flag = "TPFling",
		Callback = function(Value)
			isTPFlinging = Value
			if isTPFlinging then
				local targetNames = targetPlayers
				if #targetNames == 0 then
					isTPFlinging = false
					return
				end
				tpFlingThread = coroutine.wrap(function()
					while isTPFlinging do
						for _, name in pairs(targetNames) do
							local glove, event = getglove()
							if not (glove and event) then return end
							local targetPlayer = findTargetPlayer(name)
							if not targetPlayer or isWhitelisted(targetPlayer) or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
								return
							end
							local myHRP = localplr.Character and localplr.Character:FindFirstChild("HumanoidRootPart")
							local targetHRP = targetPlayer.Character.HumanoidRootPart
							if myHRP and targetHRP then
								local diff = myHRP.Position - targetHRP.Position
								local distance = diff.Magnitude
								if distance < 6 then return end
								local factor = math.clamp(distance / 5, 1, 120) * 1.2
								local flingDirection = diff.Unit * factor
								flingDirection = Vector3.new(flingDirection.X * 0.7, flingDirection.Y / 3, flingDirection.Z * 0.7)
								event:FireServer("slash", targetPlayer.Character, flingDirection)
							end
						end
						task.wait(1/12)
					end
				end)()
			else
				if tpFlingThread then
					tpFlingThread = nil
				end
