	-- ホワイトリストとターゲットの管理
	local whitelistPlayers = {}
	local function isWhitelisted(player)
		local lname = player.Name:lower()
		local dname = player.DisplayName and player.DisplayName:lower() or lname
		for _, wn in pairs(whitelistPlayers) do
			if string.find(lname, wn) or string.find(dname, wn) then
				return true
			end
		end
		return false
	end

	local targetPlayers = {}
	local function isTarget(player)
		local lname = player.Name:lower()
		for _, tn in pairs(targetPlayers) do
			if string.find(lname, tn) then
				return true
			end
		end
		return false
	end

	local function getTargetPlayers(input)
		local targets = {}
		for name in string.gmatch(input, "([^%.]+)") do
			table.insert(targets, name:lower())
		end
		return targets
	end

	local function findTargetPlayer(name)
		local lowerName = name:lower()
		for _, plr in pairs(game.Players:GetPlayers()) do
			if plr ~= localplr and plr.Character then
				if string.find(plr.Name:lower(), lowerName) or (plr.DisplayName and string.find(plr.DisplayName:lower(), lowerName)) then
					return plr
				end
			end
		end
		return nil
	end

	-- グローブ取得関数
	local function getglove()
		for _, v in pairs(game.Players:GetPlayers()) do
			if v.Character then
				for _, tool in pairs(v.Character:GetChildren()) do
					if tool:IsA("Tool") and (string.find(tool.Name:lower(), "glove") or string.find(tool.Name:lower(), "slap")) and tool:FindFirstChild("Event") then
						return tool, tool.Event
					end
				end
			end
			if v:FindFirstChild("Backpack") then
				for _, tool in pairs(v.Backpack:GetChildren()) do
					if tool:IsA("Tool") and (string.find(tool.Name:lower(), "glove") or string.find(tool.Name:lower(), "slap")) and tool:FindFirstChild("Event") then
						return tool, tool.Event
					end
				end
			end
		end
		for _, v in pairs(game.ReplicatedStorage:GetDescendants()) do
			if v:IsA("Tool") and (string.find(v.Name:lower(), "glove") or string.find(v.Name:lower(), "slap")) and v:FindFirstChild("Event") then
				return v, v.Event
			end
		end
		return nil, nil
	end

	-- Anti-Slap/Fling機能
	local as = false
	local function dobv(v, char)
		local undo = false
		if as then
			if v:IsA("BodyAngularVelocity") then
				undo = true
				v:Destroy()
			elseif v:IsA("BodyGyro") and v.MaxTorque ~= Vector3.new(8999999488, 8999999488, 8999999488) and v.D ~= 500 and v.D ~= 50 and v.P ~= 90000 then
				undo = true
				v:Destroy()
			elseif v:IsA("BodyVelocity") and v.MaxForce ~= Vector3.new(8999999488, 8999999488, 8999999488) and v.Velocity ~= Vector3.new(0, 0, 0) then
				undo = true
				v:Destroy()
			elseif v:IsA("BasePart") then
				v.ChildAdded:Connect(function(v2)
					dobv(v2, char)
				end)
			end
			if undo and char and char:FindFirstChild("Humanoid") then
				char.Humanoid.Sit = false
				char.Humanoid.PlatformStand = false
			end
		end
	end

	local function dc(c)
		for _, v in pairs(c:GetChildren()) do
			dobv(v, c)
		end
		c.ChildAdded:Connect(function(v)
			dobv(v, c)
		end)
	end
