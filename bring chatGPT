local lastPointerDownAt = 0
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then
        return
    end
    if
        input.UserInputType == Enum.UserInputType.MouseButton1 or
        input.UserInputType == Enum.UserInputType.Touch
    then
        lastPointerDownAt = os.clock()
    end
end)

local isDropdownOpen = false

pcall(function()
    if Dropdown.OnOpen then
        Dropdown:OnOpen(function()
            isDropdownOpen = true
        end)
    end
    if Dropdown.OnClose then
        Dropdown:OnClose(function()
            isDropdownOpen = false
        end)
    end
end)

local refreshPending = false

local function refreshDropdownSafe()
    if refreshPending then
        return
    end
    refreshPending = true
    task.spawn(function()
        task.wait(0.15)
        local deadline = os.clock() + 3
        while (os.clock() - lastPointerDownAt) < 0.8 do
            if os.clock() > deadline then
                break
            end
            task.wait(0.1)
        end
        local opened = false
        local ok, res = pcall(function()
            return
                isDropdownOpen
                or Dropdown.Opened
                or Dropdown.IsOpen
                or Dropdown._Opened
                or (Dropdown.IsOpened and Dropdown:IsOpened())
        end)
        if ok and res then
            opened = true
        end
        if not opened then
            playerOptions, labelToName = buildPlayerOptions()
            if #playerOptions == 0 then
                Dropdown:Refresh({ "(他プレイヤーなし)" })
                selectedLabel = nil
            else
                if not selectedLabel or not labelToName[selectedLabel] then
                    selectedLabel = playerOptions[1]
                end
                Dropdown:Refresh(playerOptions)
                Dropdown:Select(selectedLabel)
            end
        end
        refreshPending = false
    end)
end

Players.PlayerAdded:Connect(refreshDropdownSafe)
