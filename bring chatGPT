-- Anti Gucci (Blobman + Orion / ラグドール必須・アンカー無し・10億ワープ)

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- ココたん指定の Orion UI
local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/jadpy/suki/refs/heads/main/orion"))()

local antiGucciOn = false
local currentBlob = nil

local function getRemotes()
    local menuToys    = ReplicatedStorage:FindFirstChild("MenuToys")
    local charEvents  = ReplicatedStorage:FindFirstChild("CharacterEvents")
    if not menuToys or not charEvents then return end
    local spawnRemote   = menuToys:FindFirstChild("SpawnToyRemoteFunction")
    local ragdollRemote = charEvents:FindFirstChild("RagdollRemote")
    if not spawnRemote or not ragdollRemote then return end
    return spawnRemote, ragdollRemote
end

local function startAntiGucci()
    if antiGucciOn then return end
    antiGucciOn = true

    local spawnRemote, ragdollRemote = getRemotes()
    if not spawnRemote then
        antiGucciOn = false
        return
    end

    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local Humanoid  = Character:WaitForChild("Humanoid")
    local HRP       = Character:WaitForChild("HumanoidRootPart")

    -- ブロブマンを1スタッド前にスポーン
    local spawnCF = HRP.CFrame * CFrame.new(0, 0, -1)
    spawnRemote:InvokeServer("CreatureBlobman", spawnCF, Vector3.new(0, -16.157, 0))

    -- ブロブマン取得
    local toysFolder = Workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys")
    local Blob       = toysFolder:WaitForChild("CreatureBlobman")
    currentBlob      = Blob

    -- ネットワークオーナーだけ自分にしておく（アンカーはしない）
    for _, part in ipairs(Blob:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                part:SetNetworkOwner(LocalPlayer)
            end)
        end
    end

    local Seat = Blob:WaitForChild("VehicleSeat")

    -- イスに座らせ続ける
    task.spawn(function()
        while antiGucciOn and currentBlob == Blob do
            if Seat.Occupant ~= Humanoid then
                Seat:Sit(Humanoid)
            end
            task.wait(0.1)
        end
    end)

    -- ラグドール連打（ラグドールが無いと anti Gucci 効かない想定なので常時撃つ）
    task.spawn(function()
        while antiGucciOn and currentBlob == Blob do
            for _ = 1, 12 do
                ragdollRemote:FireServer(HRP, 0)
            end
            task.wait(0.2) -- 重かったらここを大きくする
        end
    end)

    -- 常に IsHeld = true にして「掴まれている」状態にする
    task.spawn(function()
        while antiGucciOn and currentBlob == Blob do
            pcall(function()
                local isHeld = LocalPlayer:FindFirstChild("IsHeld")
                if isHeld then
                    isHeld.Value = true
                end
            end)
            task.wait()
        end
    end)
end

local function warpBlobUp()
    if not currentBlob or not currentBlob.Parent then
        return
    end

    local Character = LocalPlayer.Character
    local HRP = Character and Character:WaitForChild("HumanoidRootPart", 1)
    if not HRP then return end

    -- 10億スタッド上へワープ
    local targetPos = HRP.Position + Vector3.new(0, 1000000000, 0)

    if currentBlob.PrimaryPart then
        pcall(function()
            currentBlob:PivotTo(CFrame.new(targetPos))
        end)
    else
        local Seat = currentBlob:FindFirstChild("VehicleSeat") or currentBlob:FindFirstChildWhichIsA("VehicleSeat")
        local origin
        if Seat then
            origin = Seat.Position
        else
            local ok, cf = pcall(function()
                return currentBlob:GetModelCFrame()
            end)
            origin = ok and cf.Position or currentBlob:GetChildren()[1].Position
        end

        for _, part in ipairs(currentBlob:GetDescendants()) do
            if part:IsA("BasePart") then
                local offset = part.Position - origin
                part.Position = targetPos + offset
            end
        end
    end

    currentBlob = nil
end

local function stopAntiGucci()
    if not antiGucciOn then return end
    antiGucciOn = false
    warpBlobUp()
end

--=== Orion UI ===--
local Window = OrionLib:MakeWindow({
    Name        = "Anti-Gucci Test",
    HidePremium = true,
    SaveConfig  = false
})

local Tab = Window:MakeTab({
    Name        = "Main",
    Icon        = "rbxassetid://7733960981",
    PremiumOnly = false
})

Tab:AddToggle({
    Name    = "Anti Gucci 起動",
    Default = false,
    Callback = function(value)
        if value then
            startAntiGucci()
        else
            stopAntiGucci()
        end
    end
})

OrionLib:Init()
