-- Orion UI を使った Blobman アンチぐっちトグル版
-- ・Blobman を自分の1スタッド前にスポーン
-- ・スポーン後、全パーツ Anchored = true ＋ NetworkOwner = LocalPlayer
-- ・座席に乗った瞬間だけラグドール化（連打）
-- ・LocalPlayer.IsHeld を常に true にして掴まれ状態維持
-- ・トグルを OFF にしたとき、Blobman を自キャラ位置から 10億スタッド上にワープ

local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Orion/main/src/Orion.lua"))()

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer       = Players.LocalPlayer
local Character         = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid          = Character:WaitForChild("Humanoid")
local HRP               = Character:WaitForChild("HumanoidRootPart")

local SpawnRemote   = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
local RagdollRemote = ReplicatedStorage:WaitForChild("CharacterEvents"):WaitForChild("RagdollRemote")

local antiGucciOn = false
local blobTasks   = {}
local currentBlob = nil

local function startAntiGucci()
    if antiGucciOn then return end
    antiGucciOn = true

    -- Blobman を1スタッド前にスポーン
    local spawnCF = HRP.CFrame + HRP.CFrame.LookVector * 1
    SpawnRemote:InvokeServer("CreatureBlobman", spawnCF, Vector3.new(0, -16.157, 0))

    -- Blobman 読み込み
    local toysFolder = workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys")
    local blob = toysFolder:WaitForChild("CreatureBlobman")
    currentBlob = blob

    -- 全パーツ Anchored + NetworkOwner を自分に
    for _, part in pairs(blob:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
            pcall(function()
                part:SetNetworkOwner(LocalPlayer)
            end)
        end
    end

    local seat = blob:WaitForChild("VehicleSeat")
    local hasRagdolled = false

    -- 自動で座る＋乗った瞬間だけラグドール連打
    table.insert(blobTasks, task.spawn(function()
        while antiGucciOn do
            if seat.Occupant ~= Humanoid then
                seat:Sit(Humanoid)
                hasRagdolled = false
            elseif not hasRagdolled then
                for _ = 1, 12 do
                    RagdollRemote:FireServer(HRP, 0)
                end
                hasRagdolled = true
            end
            task.wait(0.1)
        end
    end))

    -- ずっと IsHeld = true にして「掴まれ状態」を維持
    table.insert(blobTasks, task.spawn(function()
        while antiGucciOn do
            pcall(function()
                LocalPlayer.IsHeld.Value = true
            end)
            task.wait()
        end
    end))
end

local function stopAntiGucci()
    if not antiGucciOn then return end
    antiGucciOn = false

    -- タスク全部止める
    for _, t in ipairs(blobTasks) do
        if typeof(t) == "thread" then
            pcall(function()
                task.cancel(t)
            end)
        end
    end
    blobTasks = {}

    -- 最後に Blobman を自分の位置から 10億スタッド上へワープ
    if currentBlob and currentBlob.Parent then
        local targetPos = HRP.Position + Vector3.new(0, 1000000000, 0) -- 10^9

        if currentBlob.PrimaryPart then
            currentBlob:PivotTo(CFrame.new(targetPos))
        else
            -- PrimaryPart が無ければ VehicleSeat かモデル中心を基準に移動
            local seat = currentBlob:FindFirstChild("VehicleSeat") or currentBlob:FindFirstChildWhichIsA("VehicleSeat")
            local origin = seat and seat.Position or currentBlob:GetModelCFrame().Position

            for _, part in pairs(currentBlob:GetDescendants()) do
                if part:IsA("BasePart") then
                    local offset = part.Position - origin
                    part.Position = targetPos + offset
                end
            end
        end
    end

    currentBlob = nil
end

-- Orion UI ウィンドウとトグル
local Window = OrionLib:MakeWindow({
    Name        = "Anti-Gucci Tool",
    HidePremium = false,
    SaveConfig  = false
})

local Tab = Window:MakeTab({
    Name        = "Main",
    Icon        = "rbxassetid://7733960981",
    PremiumOnly = false
})

Tab:AddToggle({
    Name    = "アンチぐっち起動",
    Default = false,
    Callback = function(value)
        if value then
            startAntiGucci()
        else
            stopAntiGucci()
        end
    end
})

OrionLib:Init()
