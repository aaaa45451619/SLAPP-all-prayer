local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local HRP = Character:WaitForChild("HumanoidRootPart")

local SpawnRemote = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
local RagdollRemote = ReplicatedStorage:WaitForChild("CharacterEvents"):WaitForChild("RagdollRemote")

-- 座る前の位置を記録
local OriginalCFrame = HRP.CFrame

-- CreatureBlobmanすぽーん
local SkyHeight = 3
SpawnRemote:InvokeServer("CreatureBlobman", HRP.CFrame + Vector3.new(0, SkyHeight, 0), Vector3.new(0, -16.157, 0))

-- Blobman がロードされるまで待つ
local Blob = workspace:WaitForChild(LocalPlayer.Name.."SpawnedInToys"):WaitForChild("CreatureBlobman")

-- 全パーツを固定
for _, part in pairs(Blob:GetDescendants()) do
    if part:IsA("BasePart") then
        part.Anchored = true
    end
end

local Seat = Blob:WaitForChild("VehicleSeat")

-- 自動で座る処理
task.spawn(function()
    while true do
        if Seat.Occupant ~= Humanoid then
            Seat:Sit(Humanoid)
        end
        task.wait(0.1)
    end
end)

-- 座る前の位置にTP
task.spawn(function()
    while true do
        if Humanoid.SeatPart == Seat then
            HRP.CFrame = OriginalCFrame
        end
        task.wait(0.1)
    end
end)

-- キャラを常に拘束状態
task.spawn(function()
    while true do
        pcall(function()
            LocalPlayer.IsHeld.Value = true
        end)
        task.wait()
    end
end)

-- ラグドール化連打
task.spawn(function()
    while true do
        for _ = 1, 12 do
            RagdollRemote:FireServer(HRP, 0)
        end
        task.wait()
    end
end)
