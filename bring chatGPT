local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid    = Character:WaitForChild("Humanoid")
local HRP         = Character:WaitForChild("HumanoidRootPart")

local SpawnRemote   = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
local RagdollRemote = ReplicatedStorage:WaitForChild("CharacterEvents"):WaitForChild("RagdollRemote")

-- ▼ ブロブマンを 1 スタッド前にスポーン
local spawnCF = HRP.CFrame * CFrame.new(0, 0, -1)
SpawnRemote:InvokeServer("CreatureBlobman", spawnCF, Vector3.new(0, -16.157, 0))

-- ▼ ブロブマン取得
local BlobFolder = Workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys")
local Blob       = BlobFolder:WaitForChild("CreatureBlobman")

