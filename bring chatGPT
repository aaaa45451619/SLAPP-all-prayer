local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local HRP = Character:WaitForChild("HumanoidRootPart")

local SpawnRemote = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
local RagdollRemote = ReplicatedStorage:WaitForChild("CharacterEvents"):WaitForChild("RagdollRemote")

-- 座る前の位置を記録
local OriginalCFrame = HRP.CFrame

-- CreatureBlobman を3スタッド前にスポーン
local spawnCFrame = HRP.CFrame * CFrame.new(0, 0, -3)
SpawnRemote:InvokeServer("CreatureBlobman", spawnCFrame, Vector3.new(0, -16.157, 0))

-- Blobman がロードされるまで待つ
local toysFolder = workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys")
local Blob = toysFolder:WaitForChild("CreatureBlobman")

-- 全パーツを固定し、ネットワークオーナーを自分に設定
for _, part in pairs(Blob:GetDescendants()) do
    if part:IsA("BasePart") then
        part.Anchored = true
        pcall(function()
            part:SetNetworkOwner(LocalPlayer)
        end)
    end
end

local Seat = Blob:WaitForChild("VehicleSeat")
local hasRagdolled = false

-- 自動で座る処理＋ラグドール化
task.spawn(function()
    while true do
        -- 座席に座っていなければ座る
        if Seat.Occupant ~= Humanoid then
            Seat:Sit(Humanoid)
        end
        -- 乗った瞬間にラグドール化
        if Seat.Occupant == Humanoid and not hasRagdolled then
            for _ = 1, 12 do
                RagdollRemote:FireServer(HRP, 0)
            end
            hasRagdolled = true
        end
        -- 降りている間はラグドールフラグをリセット
        if Seat.Occupant ~= Humanoid and hasRagdolled then
            hasRagdolled = false
        end
        task.wait(0.1)
    end
end)

-- 座る前の位置にTP
task.spawn(function()
    while true do
        if Humanoid.SeatPart == Seat then
            HRP.CFrame = OriginalCFrame
        end
        task.wait(0.1)
    end
end)

-- キャラを常に拘束状態
task.spawn(function()
    while true do
        pcall(function()
            LocalPlayer.IsHeld.Value = true
        end)
        task.wait()
    end
end)

-- ラグドール化連打
task.spawn(function()
    while true do
        for _ = 1, 12 do
            RagdollRemote:FireServer(HRP, 0)
        end
        task.wait()
    end
end)

-- 十分な遅延を置いた後、ネットワークオーナー権限で600,000,000スタッド上へテレポート
task.delay(2, function()
    local targetPos = HRP.Position + Vector3.new(0, 600000000, 0)
    if Blob.PrimaryPart then
        Blob:PivotTo(CFrame.new(targetPos))
    else
        -- PrimaryPartが無い場合は座席位置を基準に各パーツを移動
        local origin = Seat.Position
        for _, part in pairs(Blob:GetDescendants()) do
            if part:IsA("BasePart") then
                local offset = part.Position - origin
                part.Position = targetPos + offset
            end
        end
    end
end)
