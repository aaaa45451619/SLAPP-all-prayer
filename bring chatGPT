-- Anti Gucci (Blobman + Orion / アンカーなし・ラグドール必須・10億ワープ)
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")
local LocalPlayer       = Players.LocalPlayer

-- Orion UI ローダー
local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/jadpy/suki/refs/heads/main/orion"))()

local antiGucciOn = false
local currentBlob = nil
local spawnRemote
local ragdollRemote

local function GetRemotes()
    if spawnRemote and ragdollRemote then
        return true
    end
    local menuToys    = ReplicatedStorage:FindFirstChild("MenuToys")
    local charEvents  = ReplicatedStorage:FindFirstChild("CharacterEvents")
    if not menuToys or not charEvents then return false end
    spawnRemote   = menuToys:FindFirstChild("SpawnToyRemoteFunction")
    ragdollRemote = charEvents:FindFirstChild("RagdollRemote")
    return (spawnRemote and ragdollRemote) ~= nil
end

local function StartAntiGucci()
    if antiGucciOn then return end
    if not GetRemotes() then return end
    antiGucciOn = true

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid  = character:WaitForChild("Humanoid")
    local hrp       = character:WaitForChild("HumanoidRootPart")

    local spawnCF = hrp.CFrame * CFrame.new(0, 0, -1)
    spawnRemote:InvokeServer("CreatureBlobman", spawnCF, Vector3.new(0, -16.157, 0))

    local toysFolder = Workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys")
    local blob       = toysFolder:WaitForChild("CreatureBlobman")
    currentBlob      = blob

    for _, part in ipairs(blob:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function() part:SetNetworkOwner(LocalPlayer) end)
        end
    end

    local seat = blob:WaitForChild("VehicleSeat")
    task.spawn(function()
        if humanoid and humanoid.Parent then
            seat:Sit(humanoid)
        end
    end)

    task.spawn(function()
        while antiGucciOn and currentBlob == blob do
            if humanoid.Parent then
                for _ = 1, 12 do
                    ragdollRemote:FireServer(hrp, 0)
                end
            end
            task.wait(0.25)
        end
    end)

    task.spawn(function()
        while antiGucciOn and currentBlob == blob do
            pcall(function()
                local isHeld = LocalPlayer:FindFirstChild("IsHeld")
                if isHeld then
                    isHeld.Value = true
                end
            end)
            task.wait()
        end
    end)

    task.spawn(function()
        task.wait(4)
        if not antiGucciOn then return end
        if currentBlob ~= blob then return end
        if not blob or not blob.Parent then return end
        local c = LocalPlayer.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local targetPos = root.Position + Vector3.new(0, 1000000000, 0)
        if blob.PrimaryPart then
            pcall(function() blob:PivotTo(CFrame.new(targetPos)) end)
        else
            local originPart = blob:FindFirstChild("VehicleSeat") or blob:FindFirstChildWhichIsA("BasePart")
            local origin = originPart and originPart.Position or blob:GetChildren()[1].Position
            for _, part in ipairs(blob:GetDescendants()) do
                if part:IsA("BasePart") then
                    local offset = part.Position - origin
                    part.Position = targetPos + offset
                end
            end
        end
    end)
end

local function StopAntiGucci()
    if not antiGucciOn then return end
    antiGucciOn  = false
    currentBlob  = nil
end

-- UI作成
local window = OrionLib:MakeWindow({
    Name        = "Anti-Gucci Test",
    HidePremium = true,
    SaveConfig  = false
})
local tab = window:MakeTab({
    Name        = "Main",
    Icon        = "rbxassetid://7733960981",
    PremiumOnly = false
})
tab:AddToggle({
    Name    = "Anti Gucci 起動",
    Default = false,
    Callback = function(on)
        if on then
            StartAntiGucci()
        else
            StopAntiGucci()
        end
    end
})
OrionLib:Init()
