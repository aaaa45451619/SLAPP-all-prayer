local Seat = Blob:WaitForChild("VehicleSeat")

----------------------------------------------------------------------
-- ① 必要なときだけ座らせる（乗り直しを連打しないようにする）
----------------------------------------------------------------------

local function ensureSeated()
    -- すでにこのシートに座ってるなら何もしない
    if Humanoid.Sit and Humanoid.SeatPart == Seat then
        return
    end
    -- 座っていない / 別のシートなら一回だけ乗せる
    Seat:Sit(Humanoid)
end

-- 最初に一回座らせる
ensureSeated()

-- 「座り状態が変わった時」にだけチェックして乗せ直す
Humanoid.Seated:Connect(function(isSeated, seatPart)
    -- 降りた瞬間だけ再び座らせる
    if not isSeated then
        task.delay(0.1, function()
            -- まだこのスクリプトが生きていて、かつ座っていなければ再度座らせる
            if Humanoid and Humanoid.Parent and Humanoid.Sit == false then
                ensureSeated()
            end
        end)
    end
end)

----------------------------------------------------------------------
-- ② ラグドール：座っている間だけ定期的に撃つ
----------------------------------------------------------------------

task.spawn(function()
    while true do
        if Humanoid.Parent and Humanoid.Sit and Humanoid.SeatPart == Seat then
            -- 座っている間だけラグドール連打（必要なら回数・間隔を調整）
            for _ = 1, 12 do
                RagdollRemote:FireServer(HRP, 0)
            end
        end
        task.wait(0.2) -- 連打間隔（重かったら増やす）
    end
end)

----------------------------------------------------------------------
-- ③ IsHeld を常に true に維持
----------------------------------------------------------------------

task.spawn(function()
    while true do
        pcall(function()
            local isHeld = LocalPlayer:FindFirstChild("IsHeld")
            if isHeld then
                isHeld.Value = true
            end
        end)
        task.wait()
    end
end)
