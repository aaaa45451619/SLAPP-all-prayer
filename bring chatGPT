-- FTAP Blobman 拘束アンチぐっち改良版

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local Character
local Humanoid
local HRP

local SpawnRemote = ReplicatedStorage:WaitForChild("MenuToys"):WaitForChild("SpawnToyRemoteFunction")
local RagdollRemote = ReplicatedStorage:WaitForChild("CharacterEvents"):WaitForChild("RagdollRemote")

local AntiGlitchEnabled = false
local OriginalCFrame
local Blob
local Seat

local SkyHeight = 5000000

local function SetupCharacter(char)
    Character = char
    Humanoid = char:WaitForChild("Humanoid")
    HRP = char:WaitForChild("HumanoidRootPart")
    OriginalCFrame = HRP.CFrame
end

if LocalPlayer.Character then
    SetupCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(char)
    SetupCharacter(char)
end)

local function GetBlobFolder()
    local folderName = LocalPlayer.Name .. "SpawnedInToys"
    local folder = Workspace:FindFirstChild(folderName)
    if not folder then
        folder = Workspace:WaitForChild(folderName, 5)
    end
    return folder
end

local function SpawnOrGetBlobman()
    if Blob and Blob.Parent then
        return Blob
    end

    if not HRP then
        return nil
    end

    local folder = GetBlobFolder()

    if folder then
        Blob = folder:FindFirstChild("CreatureBlobman")
    end

    if not Blob then
        local ok = pcall(function()
            SpawnRemote:InvokeServer(
                "CreatureBlobman",
                HRP.CFrame + Vector3.new(0, SkyHeight, 0),
                Vector3.new(0, -16.157, 0)
            )
        end)
        if not ok then
            warn("SpawnToyRemoteFunction Invoke 失敗")
            return nil
        end

        folder = folder or GetBlobFolder()
        if not folder then
            warn("SpawnedInToys フォルダが見つからない")
            return nil
        end

        Blob = folder:WaitForChild("CreatureBlobman", 5)
    end

    if not Blob then
        warn("CreatureBlobman が見つからない")
        return nil
    end

    for _, part in pairs(Blob:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
        end
    end

    Seat = Blob:FindFirstChildOfClass("VehicleSeat") or Blob:FindFirstChild("VehicleSeat")
    if not Seat then
        warn("Blobman 内に VehicleSeat が見つからない")
        return nil
    end

    return Blob
end

local function ForceHeldLoop()
    while AntiGlitchEnabled do
        pcall(function()
            local isHeld = LocalPlayer:FindFirstChild("IsHeld")
            if not isHeld and Character then
                isHeld = Character:FindFirstChild("IsHeld")
            end
            if isHeld and isHeld.Value ~= true then
                isHeld.Value = true
            end
        end)
        task.wait(0.05)
    end
end

local function SeatLoop()
    while AntiGlitchEnabled do
        if Seat and Humanoid then
            if Seat.Occupant ~= Humanoid then
                Seat:Sit(Humanoid)
            end
        end
        task.wait(0.1)
    end
end

local function TeleportBackLoop()
    while AntiGlitchEnabled do
        if Humanoid and HRP and Seat and OriginalCFrame then
            if Humanoid.SeatPart == Seat then
                if (HRP.Position - OriginalCFrame.Position).Magnitude > 2 then
                    HRP.CFrame = OriginalCFrame
                end
            end
        end
        task.wait(0.1)
    end
end

local function RagdollLoop()
    while AntiGlitchEnabled do
        if HRP then
            pcall(function()
                for _ = 1, 8 do
                    RagdollRemote:FireServer(HRP, 0)
                end
            end)
        end
        task.wait(0.05)
    end
end

local function StartAntiGlitch()
    if AntiGlitchEnabled then
        return
    end
    if not Character or not Humanoid or not HRP then
        warn("キャラがまだ準備できていません")
        return
    end

    if not SpawnOrGetBlobman() then
        warn("Blobman の準備に失敗しました")
        return
    end

    AntiGlitchEnabled = true

    task.spawn(ForceHeldLoop)
    task.spawn(SeatLoop)
    task.spawn(TeleportBackLoop)
    task.spawn(RagdollLoop)
end

local function StopAntiGlitch()
    AntiGlitchEnabled = false
    pcall(function()
        local isHeld = LocalPlayer:FindFirstChild("IsHeld") or (Character and Character:FindFirstChild("IsHeld"))
        if isHeld then
            isHeld.Value = false
        end
    end)
end

StartAntiGlitch()
-- Orion からトグルしたい場合:
--  ON にするとき StartAntiGlitch()
--  OFF にするとき StopAntiGlitch()
