local playerOptions, labelToName = {}, {}
local selectedLabel
local Dropdown

local function buildPlayerOptions()
    local opts, map = {}, {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local label = string.format(
                "%s (@%s)",
                plr.DisplayName or plr.Name,
                plr.Name
            )
            table.insert(opts, label)
            map[label] = plr.Name
        end
    end
    table.sort(opts, function(a, b)
        return a:lower() < b:lower()
    end)
    return opts, map
end

