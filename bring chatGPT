--================= カメラ制御 =================
local camLockCount    = 0
local savedCamType    = nil
local savedCamSubject = nil
local savedCamCFrame  = nil

local function getCamera()
    return Workspace.CurrentCamera
end

local function lockCameraAtPosition(focusCF)
    local cam = getCamera()
    if not cam then
        return
    end
    if camLockCount == 0 then
        savedCamType    = cam.CameraType
        savedCamSubject = cam.CameraSubject
        savedCamCFrame  = cam.CFrame
    end
    camLockCount += 1

    local focusPos = focusCF.Position
    -- 真上5スタッドから真下に見下ろす
    local camPos   = focusPos + Vector3.new(0, 5, 0)

    cam.CameraType = Enum.CameraType.Scriptable
    cam.CFrame     = CFrame.new(camPos, focusPos)
end

local function releaseCamera()
    local cam = getCamera()
    if not cam then
        camLockCount = 0
        return
    end
    if camLockCount <= 0 then
        camLockCount = 0
        return
    end
    camLockCount -= 1
    if camLockCount == 0 then
        cam.CameraType = savedCamType or Enum.CameraType.Custom
        if savedCamSubject then
            cam.CameraSubject = savedCamSubject
        end
        if savedCamCFrame then
            cam.CFrame = savedCamCFrame
        end
    end
end

--================= 除外（家 / フレンド） =================
local EX_ZONES, EX_SET = {}, {}
local exEnabled, rescanAlive, massBusy = true, false, false

local function getCFSize(inst)
    if inst:IsA("Model") then
        local cf, size = inst:GetBoundingBox()
        return cf, size
    elseif inst:IsA("BasePart") then
        return inst.CFrame, inst.Size
    end
end

local function clearExZones()
    table.clear(EX_ZONES)
    table.clear(EX_SET)
end

local function addZone(inst)
    if not inst or EX_SET[inst] then
        return false
    end
    local target = inst:IsA("Model") and inst or inst:FindFirstAncestorOfClass("Model") or inst
    local cf, size = getCFSize(target)
    if not cf then
        return false
    end
    table.insert(EX_ZONES, { inst = target, cf = cf, size = size })
    EX_SET[target] = true
    return true
end

local function scanPlots()
    if massBusy then
        return 0
    end
    clearExZones()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then
        return 0
    end
    local n = 0
    for _, plot in ipairs(plots:GetChildren()) do
        if plot.Name:lower():find("plot") then
            local barrier = plot:FindFirstChild("Barrier")
            if barrier then
                local pb = barrier:FindFirstChild("PlotBarrier", true)
                if addZone(pb or barrier) then
                    n += 1
                end
            end
        end
    end
    return n
end

local function pointInsideOBB(worldPoint, cf, size)
    local p = cf:PointToObjectSpace(worldPoint)
    return math.abs(p.X) <= size.X / 2
        and math.abs(p.Y) <= size.Y / 2
        and math.abs(p.Z) <= size.Z / 2
end

local function isPlayerInsideAnyExZone_withSnapshot(player, snapshot)
    local ch = player and player.Character
    if not ch then
        return false
    end
    local root =
        ch:FindFirstChild("HumanoidRootPart")
        or ch:FindFirstChild("Torso")
        or ch:FindFirstChild("UpperTorso")
    if not root then
        return false
    end
    local pos = root.Position
    for i = 1, #snapshot do
        local z = snapshot[i]
        if z.inst and z.inst.Parent and pointInsideOBB(pos, z.cf, z.size) then
            return true
        end
    end
    return false
end

local function startRescanLoop()
    if rescanAlive then
        return
    end
    rescanAlive = true
    task.spawn(function()
        while rescanAlive and exEnabled do
            if not massBusy then
                scanPlots()
            end
            task.wait(2.0)
        end
    end)
end

local function stopRescanLoop()
    rescanAlive = false
    clearExZones()
end

