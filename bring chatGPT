-- Orion UI ライブラリを読み込み
local OrionLib = loadstring(game:HttpGet("https://github.com/VerbalHubz/Verbal-Hub/raw/refs/heads/main/Orion%20Hub%20Ui%20V3"))()
-- 必要なサービス・変数
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer       = Players.LocalPlayer
local Character         = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid          = Character:WaitForChild("Humanoid")
local HRP               = Character:WaitForChild("HumanoidRootPart")

local MenuToys    = ReplicatedStorage:WaitForChild("MenuToys")
local SpawnRemote = MenuToys:WaitForChild("SpawnToyRemoteFunction")
local CharacterEvents = ReplicatedStorage:WaitForChild("CharacterEvents")
local RagdollRemote   = CharacterEvents:WaitForChild("RagdollRemote")

-- 処理用フラグ
local antiGucciOn = false
local blobTasks   = {} -- タスクを格納してあとで停止する用

-- Blobmanを召喚・上空へ飛ばす処理
local function startAntiGucci()
    if antiGucciOn then return end
    antiGucciOn = true

    -- 座る前の位置を記憶
    local originalCF = HRP.CFrame

    -- 5スタッド前にBlobmanをスポーン
    local spawnCF = HRP.CFrame * CFrame.new(0, 0, -5)
    SpawnRemote:InvokeServer("CreatureBlobman", spawnCF, Vector3.new(0, -16.157, 0))

    -- Blobman読み込み
    local toysFolder = workspace:WaitForChild(LocalPlayer.Name.."SpawnedInToys")
    local Blob = toysFolder:WaitForChild("CreatureBlobman")

    -- 全パーツを固定し、ネットワークオーナーを自分に
    for _, part in pairs(Blob:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
            pcall(function() part:SetNetworkOwner(LocalPlayer) end)
        end
    end

    local Seat = Blob:WaitForChild("VehicleSeat")

    -- 以降、複数の処理をタスクとして保持
    -- 自動で座る
    table.insert(blobTasks, task.spawn(function()
        while antiGucciOn do
            if Seat.Occupant ~= Humanoid then
                Seat:Sit(Humanoid)
            end
            task.wait(0.1)
        end
    end))

    -- 座ったら元の位置に戻す
    table.insert(blobTasks, task.spawn(function()
        while antiGucciOn do
            if Humanoid.SeatPart == Seat then
                HRP.CFrame = originalCF
            end
            task.wait(0.1)
        end
    end))

    -- 拘束状態維持
    table.insert(blobTasks, task.spawn(function()
        while antiGucciOn do
            pcall(function() LocalPlayer.IsHeld.Value = true end)
            task.wait()
        end
    end))

    -- ラグドール連打
    table.insert(blobTasks, task.spawn(function()
        while antiGucciOn do
            for _ = 1, 12 do
                RagdollRemote:FireServer(HRP, 0)
            end
            task.wait()
        end
    end))

    -- 少し待ってからBlobmanを1億スタッド上へ
    task.spawn(function()
        task.wait(1)
        local targetPos = HRP.Position + Vector3.new(0, 100000000, 0)
        if Blob.PrimaryPart then
            Blob:PivotTo(CFrame.new(targetPos))
        else
            -- PrimaryPart がない場合は座席を基準に各パーツを移動
            local origin = Seat.Position
            for _, part in pairs(Blob:GetDescendants()) do
                if part:IsA("BasePart") then
                    local offset = part.Position - origin
                    part.Position = targetPos + offset
                end
            end
        end
    end)
end

-- 停止処理
local function stopAntiGucci()
    antiGucciOn = false
    -- 登録したタスクを停止
    for _, t in ipairs(blobTasks) do
        if typeof(t) == "thread" then
            pcall(function() task.cancel(t) end)
        end
    end
    blobTasks = {}
end

-- Orion UIのウィンドウとタブを作成
local Window = OrionLib:MakeWindow({Name = "Anti-Gucci Tool (Orion)", HidePremium = false, SaveConfig = false})
local Tab    = Window:MakeTab({Name = "Main", Icon = "rbxassetid://7733960981", PremiumOnly = false})

-- トグルを追加
Tab:AddToggle({
    Name = "アンチぐっち起動",
    Default = false,
    Callback = function(value)
        if value then
            startAntiGucci()
        else
            stopAntiGucci()
        end
    end
})

-- UI起動
OrionLib:Init()
