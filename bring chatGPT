　-- Anti Gucci (Blobman + Orion UI) シンプル版
-- トグルONで：1スタッド前にBlobman出現 → 固定 → 自動で座る → 座った瞬間だけラグドール＋IsHeld維持
-- トグルOFFで：Blobmanを自キャラ位置から100億スタッド上にワープ

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Character   = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid    = Character:WaitForChild("Humanoid")
local HRP         = Character:WaitForChild("HumanoidRootPart")

local MenuToys      = ReplicatedStorage:WaitForChild("MenuToys")
local SpawnRemote   = MenuToys:WaitForChild("SpawnToyRemoteFunction")
local CharacterEvents = ReplicatedStorage:WaitForChild("CharacterEvents")
local RagdollRemote   = CharacterEvents:WaitForChild("RagdollRemote")

-- ココたん指定の Orion ローダー
local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/jadpy/suki/refs/heads/main/orion"))()

local antiGucciOn = false
local currentBlob = nil

local function startAntiGucci()
    if antiGucciOn then return end
    antiGucciOn = true

    -- 毎回キャラ取り直し（リスパ対策軽め）
    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    Humanoid  = Character:WaitForChild("Humanoid")
    HRP       = Character:WaitForChild("HumanoidRootPart")

    -- 1スタッド前に Blobman をスポーン
    local spawnCF = HRP.CFrame * CFrame.new(0, 0, -1)
    SpawnRemote:InvokeServer("CreatureBlobman", spawnCF, Vector3.new(0, -16.157, 0))

    -- Blobman 読み込み
    local toysFolder = Workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys")
    local blob = toysFolder:WaitForChild("CreatureBlobman")
    currentBlob = blob

    -- 全BasePartを固定＋ネットワークオーナーを自分に
    for _, part in ipairs(blob:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
            pcall(function()
                part:SetNetworkOwner(LocalPlayer)
            end)
        end
    end

    -- VehicleSeat取得
    local seat = blob:WaitForChild("VehicleSeat")
    local hasRagdolled = false

    -- 自動で座る＋座った瞬間だけラグドール
    task.spawn(function()
        while antiGucciOn and currentBlob == blob do
            if seat.Occupant ~= Humanoid then
                seat:Sit(Humanoid)
                hasRagdolled = false
            elseif not hasRagdolled then
                for _ = 1, 12 do
                    RagdollRemote:FireServer(HRP, 0)
                end
                hasRagdolled = true
            end
            task.wait(0.1)
        end
    end)

    -- ずっと掴まれ状態にする
    task.spawn(function()
        while antiGucciOn and currentBlob == blob do
            pcall(function()
                local isHeld = LocalPlayer:FindFirstChild("IsHeld")
                if isHeld then
                    isHeld.Value = true
                end
            end)
            task.wait()
        end
    end)
end

local function warpBlobUp()
    if not currentBlob or not currentBlob.Parent then
        return
    end

    -- 自分の位置から100億スタッド上
    local targetPos = HRP.Position + Vector3.new(0, 10000000000, 0)

    if currentBlob.PrimaryPart then
        currentBlob:PivotTo(CFrame.new(targetPos))
    else
        -- PrimaryPartが無ければVehicleSeatかモデル中心を基準に移動
        local seat = currentBlob:FindFirstChild("VehicleSeat") or currentBlob:FindFirstChildWhichIsA("VehicleSeat")
        local origin
        if seat then
            origin = seat.Position
        else
            local ok, cf = pcall(function()
                return currentBlob:GetModelCFrame()
            end)
            origin = ok and cf.Position or currentBlob:GetChildren()[1].Position
        end

        for _, part in ipairs(currentBlob:GetDescendants()) do
            if part:IsA("BasePart") then
                local offset = part.Position - origin
                part.Position = targetPos + offset
            end
        end
    end

    currentBlob = nil
end

local function stopAntiGucci()
    if not antiGucciOn then return end
    antiGucciOn = false
    warpBlobUp()
end

-- Orion UI セットアップ
local Window = OrionLib:MakeWindow({
    Name        = "Anti-Gucci Tool",
    HidePremium = true,
    SaveConfig  = false
})

local Tab = Window:MakeTab({
    Name        = "Main",
    Icon        = "rbxassetid://7733960981",
    PremiumOnly = false
})

Tab:AddToggle({
    Name    = "アンチぐっち起動",
    Default = false,
    Callback = function(v)
        if v then
            startAntiGucci()
        else
            stopAntiGucci()
        end
    end
})

OrionLib:Init()
