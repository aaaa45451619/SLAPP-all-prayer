--================= 全員ワープ =================
local SecMass = Tab:Section({
    Title  = "全員ワープ",
    Opened = true,
})

SecMass:Button({
    Title = "全員ワープグラブ",
    Desc  = "ボタン一発で全員ワープ（間隔 -1.80 / 掴み 0.18 固定）",
    Callback = function()
        if massBusy then
            WindUI:Notify({
                Title    = "処理中",
                Content  = "いま実行中だよ",
                Duration = 1.0,
                Icon     = "lucide:clock",
            })
            return
        end

        if exEnabled then
            scanPlots()
        end

        local zonesSnapshot = {}
        for i = 1, #EX_ZONES do
            local z = EX_ZONES[i]
            zonesSnapshot[i] = {
                inst = z.inst,
                cf   = z.cf,
                size = z.size,
            }
        end

        local others = {}
        local skippedHouse  = 0
        local skippedFriend = 0

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                if
                    exEnabled
                    and isPlayerInsideAnyExZone_withSnapshot(plr, zonesSnapshot)
                then
                    skippedHouse += 1
                elseif friendExEnabled and isFriend(plr) then
                    skippedFriend += 1
                else
                    table.insert(others, plr)
                end
            end
        end

        if #others == 0 then
            WindUI:Notify({
                Title    = "対象なし",
                Content  = "除外条件で対象なし",
                Duration = 1.2,
                Icon     = "lucide:ban",
            })
            return
        end

        massBusy = true
        local gap = paceSeconds

        task.spawn(function()
            if gap >= 0 then
                for _, t in ipairs(others) do
                    warpGrabEntry_Mass(t)
                    if gap <= 0 then
                        RunService.Heartbeat:Wait()
                    else
                        task.wait(gap)
                    end
                end
            else
                local i = 1
                while i <= #others do
                    local burst = math.clamp(2 + math.floor((-gap) * 40), 2, 64)
                    for _ = 1, burst do
                        if i > #others then
                            break
                        end
                        warpGrabEntry_Mass(others[i])
                        i += 1
                    end
                    RunService.Heartbeat:Wait()
                end
            end

            massBusy = false
            WindUI:Notify({
                Title   = "完了",
                Content = string.format(
                    "実行:%d / 家スキップ:%d / フレンド:%d（間隔 %.3fs / 全員保持 %.2fs）",
                    #others,
                    skippedHouse,
                    skippedFriend,
                    gap,
                    MASS_warpHoldSeconds
                ),
                Duration = 2.0,
                Icon     = "lucide:check-circle",
            })
        end)
    end,
})

