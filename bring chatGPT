--================= Utils =================
local function findPlayerByPartial(q)
    if not q or q == "" then
        return nil
    end
    q = q:lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local n = plr.Name:lower()
            local d = (plr.DisplayName or ""):lower()
            if n:find(q, 1, true) or d:find(q, 1, true) then
                return plr
            end
        end
    end
    return nil
end

local function getHRP(c)
    if not c then
        return nil
    end
    return c:FindFirstChild("HumanoidRootPart")
        or c:FindFirstChild("Torso")
        or c:FindFirstChild("UpperTorso")
end

local function getPlayerRootOrSeat(player)
    if not player or not player.Character then
        return nil
    end
    local char = player.Character
    local hrp  = getHRP(char)
    if hrp and hrp:FindFirstChildOfClass("WeldConstraint") == nil then
        return hrp
    end
    for _, seat in ipairs(Workspace:GetDescendants()) do
        if seat:IsA("VehicleSeat") and seat.Occupant and seat.Occupant.Parent == char then
            return seat
        end
    end
    return hrp
end

--================= Warp Core =================
local RETURN_PADDING       = Vector3.new(0, 0, 0)
local PULL_MULT            = 1.4
local MASS_warpHoldSeconds = 0.18
local TARGET_HOLD_FIXED    = 0.30
local FRONT_OFFSET         = 2.0
local paceSeconds          = -1.80

local function spawnGrabModelForTarget(targetHRP)
    local model = Instance.new("Model")
    model.Name = "GrabParts"
    local grabPart = Instance.new("Part")
    grabPart.Name = "GrabPart"
    grabPart.Size = Vector3.new(1, 1, 1)
    grabPart.Massless = true
    grabPart.CanCollide = false
    grabPart.CanQuery  = false
    grabPart.CanTouch  = false
    grabPart.Anchored  = false
    grabPart.Transparency = 1
    grabPart.CFrame    = targetHRP.CFrame
    grabPart.Parent    = model
    model.PrimaryPart  = grabPart
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = grabPart
    weld.Part1 = targetHRP
    weld.Parent = grabPart
    pcall(function()
        grabPart:SetNetworkOwner(LP)
    end)
    model.Parent = Workspace
    Debris:AddItem(model, 6)
    return model
end

local function auraClampTargetToCFrame(targetHRP, goalCF)
    if not targetHRP then
        return
    end
    local startT = time()
    local last = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not targetHRP or not targetHRP.Parent then
            if conn then
                conn:Disconnect()
            end
            return
        end
        pcall(function()
            if SetNetworkOwner then
                SetNetworkOwner:FireServer(targetHRP, goalCF)
            end
        end)
        targetHRP.AssemblyLinearVelocity  = Vector3.new()
        targetHRP.AssemblyAngularVelocity = Vector3.new()
        local curPos = targetHRP.Position
        local toGoal = goalCF.Position - curPos
        local dist   = toGoal.Magnitude
        if dist <= 4 or (time() - startT) >= 6 then
            if conn then
                conn:Disconnect()
            end
            return
        end
        local now = tick()
        local dt  = math.max(1 / (120 * PULL_MULT), now - last)
        last      = now
        local rate = math.clamp(dist * 90 * PULL_MULT, 120 * PULL_MULT, 1600 * PULL_MULT)
        local step = rate * dt
        local nextPos = (dist <= step)
            and goalCF.Position
            or (curPos + toGoal.Unit * step)
        local curCF = targetHRP.CFrame
        targetHRP.CFrame = CFrame.new(nextPos, nextPos + curCF.LookVector)
    end)
end

local function warpGrabThenReturnWithHold(targetPlayer, holdSeconds)
    if not targetPlayer or not targetPlayer.Character then
        return
    end
    if not Root or not Root.Parent or not Humanoid then
        return
    end
    local tHRP = getPlayerRootOrSeat(targetPlayer)
    if not tHRP then
        return
    end

    local originalCF = Root.CFrame + RETURN_PADDING

    spawnGrabModelForTarget(tHRP)

    local w  = Humanoid.WalkSpeed
    local j  = Humanoid.JumpPower
    local ar = Humanoid.AutoRotate

    Humanoid.AutoRotate = false
    Humanoid.WalkSpeed  = 0
    Humanoid.JumpPower  = 0
    pcall(function()
        Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    end)

    Root.AssemblyLinearVelocity  = Vector3.new()
    Root.AssemblyAngularVelocity = Vector3.new()

    -- カメラ固定開始（真上5m）
    lockCameraAtPosition(originalCF)

    Root.CFrame = tHRP.CFrame * CFrame.new(0, 2.2, -2.4)

    local targetGoalCF = originalCF * CFrame.new(0, 0, -FRONT_OFFSET)
    auraClampTargetToCFrame(tHRP, targetGoalCF)

    local holdT    = math.max(0.0, tonumber(holdSeconds) or 0.3)
    local deadline = time() + holdT

    local hb
    hb = RunService.Heartbeat:Connect(function()
        if time() >= deadline and hb then
            hb:Disconnect()
        end
        pcall(function()
            if SetNetworkOwner then
                SetNetworkOwner:FireServer(tHRP, Root.CFrame)
            end
        end)
    end)

    task.wait(holdT)

    Root.CFrame = originalCF
    pcall(function()
        Humanoid:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
    end)
    task.delay(0.05, function()
        Humanoid.WalkSpeed  = w
        Humanoid.JumpPower  = j
        Humanoid.AutoRotate = ar
    end)

    -- このワープ分のカメラロック解除
    releaseCamera()
end

local function warpGrabEntry_TargetFixed(namePart)
    local t = findPlayerByPartial(namePart)
    if not t then
        return
    end
    warpGrabThenReturnWithHold(t, TARGET_HOLD_FIXED)
end

local function warpGrabEntry_Mass(targetPlayer)
    warpGrabThenReturnWithHold(targetPlayer, MASS_warpHoldSeconds)
end

