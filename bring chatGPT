-- ===============================================
-- AntiGucci Toggle Script (アンカーなし + Orion UI)
-- ・ブロブマンを自分の 1 スタッド前にスポーン
-- ・座席に自動で座り続ける
-- ・座っている間 HRP を元の場所に戻すループ（見た目固定）
-- ・IsHeld を常に true にして「掴まれ状態」を維持
-- ・ラグドールを連打してアンチグラブ効果を発動
-- ・Orion UI トグルで ON/OFF 切替
-- ===============================================

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")
local LocalPlayer       = Players.LocalPlayer

-- Orion UI ライブラリ（公式）
local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Orion/main/src/Orion.lua"))()

-- 状態管理
local antiGucciActive = false
local currentBlob     = nil
local runningTasks    = {}

-- リモート取得
local function getRemotes()
    local menuToys    = ReplicatedStorage:FindFirstChild("MenuToys")
    local charEvents  = ReplicatedStorage:FindFirstChild("CharacterEvents")
    if not menuToys or not charEvents then return nil, nil end
    local spawnRemote   = menuToys:FindFirstChild("SpawnToyRemoteFunction")
    local ragdollRemote = charEvents:FindFirstChild("RagdollRemote")
    return spawnRemote, ragdollRemote
end

-- AntiGucci を開始する処理
local function startAntiGucci()
    if antiGucciActive then return end
    local spawnRemote, ragdollRemote = getRemotes()
    if not spawnRemote or not ragdollRemote then
        warn("リモートが見つかりません。")
        return
    end
    antiGucciActive = true

    -- 現在のキャラ取得
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = char:WaitForChild("Humanoid")
    local hrp = char:WaitForChild("HumanoidRootPart")

    -- ブロブマンを 1 スタッド前にスポーン
    local spawnCF = hrp.CFrame * CFrame.new(0, 0, -1)
    spawnRemote:InvokeServer("CreatureBlobman", spawnCF, Vector3.new(0, -16.157, 0))

    -- Blobman を取得
    local toysFolder = Workspace:WaitForChild(LocalPlayer.Name .. "SpawnedInToys")
    local blob = toysFolder:WaitForChild("CreatureBlobman")
    currentBlob = blob

    -- ネットワークオーナーを自分に設定（アンカー固定は行わない）
    for _, part in ipairs(blob:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function() part:SetNetworkOwner(LocalPlayer) end)
        end
    end

    -- VehicleSeat
    local seat = blob:WaitForChild("VehicleSeat")
    -- 座る前の位置を記録
    local originalCF = hrp.CFrame

    -- 座席に自動で座る処理（乗り直しを抑える）
    runningTasks.seat = task.spawn(function()
        while antiGucciActive and currentBlob == blob do
            if seat.Occupant ~= humanoid then
                seat:Sit(humanoid)
            end
            task.wait(0.1)
        end
    end)

    -- 座っている間は HRP を元の位置へ戻す処理
    runningTasks.tp = task.spawn(function()
        while antiGucciActive and currentBlob == blob do
            if humanoid.SeatPart == seat then
                hrp.CFrame = originalCF
            end
            task.wait(0.1)
        end
    end)

    -- IsHeld を常に true にして掴まれ状態にする
    runningTasks.held = task.spawn(function()
        while antiGucciActive and currentBlob == blob do
            pcall(function()
                local isHeld = LocalPlayer:FindFirstChild("IsHeld")
                if isHeld then
                    isHeld.Value = true
                end
            end)
            task.wait()
        end
    end)

    -- ラグドール化連打
    runningTasks.ragdoll = task.spawn(function()
        while antiGucciActive and currentBlob == blob do
            for _ = 1, 12 do
                ragdollRemote:FireServer(hrp, 0)
            end
            task.wait()
        end
    end)
end

-- AntiGucci を停止する処理
local function stopAntiGucci()
    if not antiGucciActive then return end
    antiGucciActive = false
    -- 各タスクを止める
    for _, t in pairs(runningTasks) do
        pcall(function() task.cancel(t) end)
    end
    runningTasks = {}
    currentBlob = nil
end

-- Orion UI ウィンドウ作成
local window = OrionLib:MakeWindow({
    Name        = "Anti-Gucci Test",
    HidePremium = true,
    SaveConfig  = false
})
local tab = window:MakeTab({
    Name        = "Main",
    Icon        = "rbxassetid://7733960981",
    PremiumOnly = false
})

-- トグル追加
tab:AddToggle({
    Name     = "Anti Gucci 起動",
    Default  = false,
    Callback = function(on)
        if on then
            startAntiGucci()
        else
            stopAntiGucci()
        end
    end
})

-- UI 初期化
OrionLib:Init()
