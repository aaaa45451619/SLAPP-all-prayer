-- Barrier Logic Loop
game:GetService("RunService").RenderStepped:Connect(function()
    if not barrierOn then return end
    if localplr.Character and localplr.Character:FindFirstChild("HumanoidRootPart") then
        barrierPart.Position = localplr.Character.HumanoidRootPart.Position
    end

    local glove, event = getglove()
    if not event then return end

    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr ~= localplr and not isWhitelisted(plr) and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = plr.Character.HumanoidRootPart
            local distance = (hrp.Position - barrierPart.Position).Magnitude
            if distance < 5 then
                local pushDir = (hrp.Position - barrierPart.Position).Unit
                event:FireServer("slash", plr.Character, pushDir * 50)
            end
        end
    end
end)

