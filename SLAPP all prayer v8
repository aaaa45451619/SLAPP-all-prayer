tpBtn.MouseButton1Click:Connect(function()
    local targetName = textbox.Text:lower()
    if targetName == "" then return end

    local glove, event = getglove()
    if not (glove and event) then return end

    for _, plr in pairs(game.Players:GetPlayers()) do
        if plr ~= localplr and not isWhitelisted(plr) and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            if string.find(plr.Name:lower(), targetName) or (plr.DisplayName and string.find(plr.DisplayName:lower(), targetName)) then
                local myHRP = localplr.Character and localplr.Character:FindFirstChild("HumanoidRootPart")
                local targetHRP = plr.Character.HumanoidRootPart
                if myHRP and targetHRP then
                    local diff = myHRP.Position - targetHRP.Position
                    local distance = diff.Magnitude
                    if distance < 6 then return end
                    local factor = math.clamp(distance / 5, 1, 120) * 1.2
                    event:FireServer("slash", plr.Character, diff.Unit * factor)
                end
            end
        end
    end
end)


