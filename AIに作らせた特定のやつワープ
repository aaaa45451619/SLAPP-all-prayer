	gui.IgnoreGuiInset = true
	gui.Parent = LP:WaitForChild("PlayerGui")

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromOffset(340, 156)
	frame.Position = UDim2.fromScale(0.07, 0.32)
	frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
	frame.BorderSizePixel = 0
	frame.Parent = gui
	Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -40, 0, 28)
	title.Position = UDim2.fromOffset(12, 8)
	title.BackgroundTransparency = 1
	title.Text = "Targeted Grab Aura - WarpGrabThenReturn"
	title.TextColor3 = Color3.new(1,1,1)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Font = Enum.Font.GothamBold
	title.TextSize = 16
	title.Parent = frame

	-- drag
	local drag = Instance.new("TextButton")
	drag.Size = UDim2.fromOffset(28, 28)
	drag.Position = UDim2.fromOffset(300, 8)
	drag.Text = "≡"
	drag.BackgroundTransparency = 0.2
	drag.Parent = frame
	Instance.new("UICorner", drag).CornerRadius = UDim.new(0, 6)
	local dragging, dragStart, startPos
	drag.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dragStart = input.Position; startPos = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)

	local nameBox = Instance.new("TextBox")
	nameBox.Size = UDim2.new(1, -24, 0, 32)
	nameBox.Position = UDim2.fromOffset(12, 44)
	nameBox.PlaceholderText = "ターゲット名 / DisplayName（部分一致OK）"
	nameBox.Text = ""
	nameBox.TextSize = 14
	nameBox.TextColor3 = Color3.new(1,1,1)
	nameBox.BackgroundColor3 = Color3.fromRGB(40,40,40)
	nameBox.ClearTextOnFocus = false
	nameBox.Parent = frame
	Instance.new("UICorner", nameBox).CornerRadius = UDim.new(0, 6)

	local runBtn = Instance.new("TextButton")
	runBtn.Size = UDim2.new(1, -24, 0, 36)
	runBtn.Position = UDim2.fromOffset(12, 96)
	runBtn.Text = "ワープ掴み→戻る（0.4秒）"
	runBtn.TextSize = 16
	runBtn.TextColor3 = Color3.new(1,1,1)
	runBtn.BackgroundColor3 = Color3.fromRGB(60,110,255)
	runBtn.Parent = frame
	Instance.new("UICorner", runBtn).CornerRadius = UDim.new(0, 8)

	runBtn.MouseButton1Click:Connect(function()
		local q = (nameBox.Text or ""):gsub("^%s*(.-)%s*$", "%1")
		if q == "" then
			runBtn.Text = "名前入れて！"
			task.delay(0.6, function() runBtn.Text = "ワープ掴み→戻る（0.4秒）" end)
			return
		end
		warpGrabEntry(q)
	end)
end

createUI()
