-- 武器取得関数
local function getglove()
    for _, v in pairs(Players:GetPlayers()) do
        if v.Character then
            for _, tool in pairs(v.Character:GetChildren()) do
                if tool:IsA("Tool") and (string.find(tool.Name:lower(), "glove") or string.find(tool.Name:lower(), "slap")) and tool:FindFirstChild("Event") then
                    return tool, tool.Event
                end
            end
        end
        if v:FindFirstChild("Backpack") then
            for _, tool in pairs(v.Backpack:GetChildren()) do
                if tool:IsA("Tool") and (string.find(tool.Name:lower(), "glove") or string.find(tool.Name:lower(), "slap")) and tool:FindFirstChild("Event") then
                    return tool, tool.Event
                end
            end
        end
    end
    return nil, nil
end

-- Kill All
Tab:CreateButton({
    Name = "Kill All",
    Callback = function()
        if not AllEnabled then
            Rayfield:Notify({
                Title = "無効",
                Content = "Kill All は現在無効化されています。",
                Duration = 4
            })
            return
        end
        local glove, event = getglove()
        if event then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= localplr and v.Character and not Whitelist[v.Name] then
                    event:FireServer("slash", v.Character, Vector3.new(0, -math.huge, 0))
                end
            end
        end
    end
})

-- Fling All
Tab:CreateButton({
    Name = "Fling All",
    Callback = function()
        if not AllEnabled then
            Rayfield:Notify({
                Title = "無効",
                Content = "Fling All は現在無効化されています。",
                Duration = 4
            })
            return
        end
        local glove, event = getglove()
        if event then
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= localplr and v.Character and v.Character:FindFirstChild("HumanoidRootPart") and not Whitelist[v.Name] then
                    event:FireServer("slash", v.Character, Vector3.new(0, math.huge, 0))
                    v.Character.HumanoidRootPart.Position = v.Character.HumanoidRootPart.Position + Vector3.new(0, 50, 0)
                end
            end
        end
    end
})

