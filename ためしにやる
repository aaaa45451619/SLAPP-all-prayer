}

-- ✅ all系機能の有効/無効フラグ
local AllEnabled = true

-- ✅ チャット監視（作成者専用コマンド）
local function setupChatListener(player)
    if player.Name == "pkp0721454519194545" then
        player.Chatted:Connect(function(msg)
            if msg == "allおふ" then
                AllEnabled = false
                Rayfield:Notify({
                    Title = "無効化",
                    Content = "作成者の発言により Kill All / Fling All が無効になりました。",
                    Duration = 6
                })
            elseif msg == "allおん" then
                AllEnabled = true
                Rayfield:Notify({
                    Title = "再有効化",
                    Content = "作成者の発言により Kill All / Fling All が再び使えるようになりました。",
                    Duration = 6
                })
            end
        end)
    end
end

-- 既存プレイヤー & 新規参加プレイヤー対応
for _, plr in pairs(Players:GetPlayers()) do
    setupChatListener(plr)
end
Players.PlayerAdded:Connect(setupChatListener)

